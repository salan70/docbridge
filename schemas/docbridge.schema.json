{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DocBridge Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["include"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "include": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "docs"],
      "properties": {
        "code": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "typescript": { "$ref": "#/$defs/typescriptEntry" },
            "swift": { "$ref": "#/$defs/swiftEntry" },
            "dart": { "$ref": "#/$defs/dartEntry" },
            "rust": { "$ref": "#/$defs/rustEntry" },
            "go": { "$ref": "#/$defs/goEntry" },
            "javascript": { "$ref": "#/$defs/javascriptEntry" },
            "python": { "$ref": "#/$defs/pythonEntry" },
            "ruby": { "$ref": "#/$defs/rubyEntry" },
            "java": { "$ref": "#/$defs/javaEntry" }
          }
        },
        "docs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "\\.md$"
          }
        }
      }
    },
    "scanners": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "python": { "$ref": "#/$defs/scannerRuntime" },
        "ruby": { "$ref": "#/$defs/scannerRuntime" },
        "java": { "$ref": "#/$defs/scannerRuntime" }
      }
    }
  },
  "$defs": {
    "scannerRuntime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command"],
      "properties": {
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "typescriptEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["patterns"],
      "properties": {
        "patterns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^(?!.*\\.d\\.[cm]?ts$).*\\.(ts|tsx|mts|cts)$"
          }
        },
        "visibility": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["public", "protected", "private"]
          }
        }
      }
    },
    "swiftEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["patterns"],
      "properties": {
        "patterns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "\\.swift$"
          }
        },
        "visibility": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["public", "open", "internal"]
          }
        }
      }
    },
    "dartEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["patterns"],
      "properties": {
        "patterns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "\\.dart$"
          }
        },
        "visibility": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["public"]
          }
        }
      }
    },
    "rustEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["patterns"],
      "properties": {
        "patterns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "\\.rs$"
          }
        },
        "visibility": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["pub", "private"]
          }
        }
      }
    },
    "goEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["patterns"],
      "properties": {
        "patterns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "\\.go$"
          }
        },
        "visibility": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["exported", "unexported"]
          }
        }
      }
    },
    "javascriptEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["patterns"],
      "properties": {
        "patterns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "\\.(js|jsx|mjs|cjs)$"
          }
        },
        "visibility": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["public", "protected", "private"]
          }
        }
      }
    },
    "pythonEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["patterns"],
      "properties": {
        "patterns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "\\.py$"
          }
        },
        "visibility": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["public", "private"]
          }
        }
      }
    },
    "rubyEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["patterns"],
      "properties": {
        "patterns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "\\.rb$"
          }
        },
        "visibility": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["public", "protected", "private"]
          }
        }
      }
    },
    "javaEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["patterns"],
      "properties": {
        "patterns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "\\.java$"
          }
        },
        "visibility": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["public", "protected", "package", "private"]
          }
        }
      }
    }
  }
}
