{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DocBridge Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["include"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "include": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "docs"],
      "properties": {
        "code": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "typescript": { "$ref": "#/$defs/typescriptEntry" },
            "swift": { "$ref": "#/$defs/swiftEntry" },
            "dart": { "$ref": "#/$defs/dartEntry" },
            "rust": { "$ref": "#/$defs/rustEntry" }
          }
        },
        "docs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "\\.md$"
          }
        }
      }
    }
  },
  "$defs": {
    "typescriptEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["patterns"],
      "properties": {
        "patterns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^(?!.*\\.d\\.ts$).*\\.ts$"
          }
        },
        "visibility": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["public", "protected", "private"]
          }
        }
      }
    },
    "swiftEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["patterns"],
      "properties": {
        "patterns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "\\.swift$"
          }
        },
        "visibility": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["public", "open", "internal"]
          }
        }
      }
    },
    "dartEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["patterns"],
      "properties": {
        "patterns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "\\.dart$"
          }
        },
        "visibility": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["public"]
          }
        }
      }
    },
    "rustEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["patterns"],
      "properties": {
        "patterns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "\\.rs$"
          }
        },
        "visibility": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["pub", "private"]
          }
        }
      }
    }
  }
}
