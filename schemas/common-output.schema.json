{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "common-output.schema.json",
  "title": "DocBridge Common Output Definitions",
  "$defs": {
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filePath", "line", "column"],
      "properties": {
        "filePath": { "type": "string" },
        "line": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 1 }
      }
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["line", "column"],
      "properties": {
        "line": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 1 }
      }
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "$ref": "#/$defs/position" },
        "end": { "$ref": "#/$defs/position" }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "code", "target", "message"],
      "properties": {
        "severity": {
          "type": "string",
          "enum": ["error", "warning"]
        },
        "code": { "type": "string" },
        "target": { "type": "string" },
        "language": {
          "type": "string",
          "enum": ["typescript", "swift", "dart"]
        },
        "source": { "type": "string" },
        "message": { "type": "string" },
        "location": { "$ref": "#/$defs/location" },
        "range": { "$ref": "#/$defs/range" }
      }
    }
  }
}
