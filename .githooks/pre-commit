#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

# Git exports GIT_DIR, GIT_INDEX_FILE, and related variables to hooks. Drop
# them so nothing `just verify` spawns (tests create throwaway git
# repositories) can act on this repository by accident; see issue #175.
run_just() {
  if [[ -n "${IN_NIX_SHELL:-}" ]]; then
    env -u GIT_DIR -u GIT_INDEX_FILE -u GIT_WORK_TREE -u GIT_PREFIX -u GIT_COMMON_DIR just "$@"
  else
    env -u GIT_DIR -u GIT_INDEX_FILE -u GIT_WORK_TREE -u GIT_PREFIX -u GIT_COMMON_DIR nix develop -c just "$@"
  fi
}

echo "Running pre-commit guard: just verify"
run_just verify

# Awareness, not a verdict: list the staged changes' linked counterparts that
# were not staged, with their content, then let the commit proceed. Judgment
# about counterparts belongs to the pull request, where CI re-runs the gate over
# the whole change set and a human approves the merge.
echo "Reporting DocBridge related-gate over the staged files"
gate_status=0
run_just related-gate-report || gate_status=$?
if [[ "$gate_status" -ne 0 ]]; then
  echo "pre-commit: the related-gate report failed (exit $gate_status); continuing." >&2
fi
