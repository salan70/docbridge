{
  "$schema": "../../../schemas/docbridge.schema.json",
  "include": {
    "code": {
      "typescript": {
        "patterns": [
          "src/**/*.ts"
        ]
      },
      "go": {
        "patterns": [
          "internal/**/*.go"
        ]
      },
      "javascript": {
        "patterns": [
          "src/**/*.cjs"
        ]
      },
      "python": {
        "patterns": [
          "src/**/*.py"
        ]
      },
      "ruby": {
        "patterns": [
          "lib/**/*.rb"
        ]
      },
      "java": {
        "patterns": [
          "src/**/*.java"
        ]
      }
    },
    "docs": [
      "docs/**/*.md"
    ]
  }
}
