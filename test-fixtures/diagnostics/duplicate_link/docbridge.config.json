{
  "$schema": "../../../schemas/docbridge.schema.json",
  "include": {
    "code": {
      "typescript": {
        "patterns": [
          "src/**/*.ts"
        ]
      },
      "swift": {
        "patterns": [
          "Sources/**/*.swift"
        ]
      },
      "dart": {
        "patterns": [
          "lib/**/*.dart"
        ]
      }
    },
    "docs": [
      "docs/**/*.md"
    ]
  }
}
