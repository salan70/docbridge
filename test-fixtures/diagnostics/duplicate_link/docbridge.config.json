{
  "$schema": "../../../schemas/docbridge.schema.json",
  "include": {
    "code": {
      "typescript": {
        "patterns": [
          "src/**/*.ts"
        ]
      },
      "swift": {
        "patterns": [
          "Sources/**/*.swift"
        ]
      },
      "dart": {
        "patterns": [
          "lib/**/*.dart"
        ]
      },
      "rust": {
        "patterns": [
          "src/**/*.rs"
        ]
      },
      "go": {
        "patterns": [
          "internal/**/*.go"
        ]
      },
      "javascript": {
        "patterns": [
          "src/**/*.js"
        ]
      },
      "python": {
        "patterns": [
          "src/**/*.py"
        ]
      },
      "ruby": {
        "patterns": [
          "lib/**/*.rb"
        ]
      },
      "java": {
        "patterns": [
          "src/**/*.java"
        ]
      }
    },
    "docs": [
      "docs/**/*.md"
    ]
  }
}
